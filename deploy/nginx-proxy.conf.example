# CertKeeper proxy TLS 示例。Compose 只把后端端口发布到宿主机回环地址。
upstream certkeeper_backend {
    server 127.0.0.1:3780;
    keepalive 16;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ck.example.com;

    ssl_certificate /etc/letsencrypt/live/ck.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ck.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://certkeeper_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 130s;
    }

    # 仅按需放行监控网段；不要将指标公开到互联网。
    location = /metrics {
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        deny all;
        proxy_pass http://certkeeper_backend;
    }
}
